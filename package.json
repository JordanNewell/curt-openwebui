{
  "name": "curt-openwebui-export",
  "version": "1.0.0",
  "description": "Export Open WebUI chats to .curt conversation files (curt-format v1)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "curt-openwebui-export": "dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('test/fixtures','dist/test/fixtures',{recursive:true})\"",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "curt-format": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
